  {
    "thinkingSkillId": "F08",
    "title": "整体与等量替换",
    "observableAction": "把一个完整对象换成相等表达",
    "applicationStructures": [
      "两袋物品",
      "间接测量"
    ],
    "requiredAuthoring": [
      "适用条件",
      "为什么成立",
      "两种不同结构的应用",
      "失效例或反例",
      "独立迁移任务",
      "保持证据规则"
    ],
    "status": "planned",
    "guide": {
      "question": "已知两样东西一样多，能用其中一个换掉另一个吗？",
      "condition": "相等关系必须已经知道；要换的是完整的一份，外面的乘法、减法和其他部分都要保留。",
      "why": "每份的数量没变，换一种写法后，整个式子表达的数量也不会变。",
      "example": "一盒里有一袋糖和2颗散糖。一袋记作x，三盒就写成3×(x＋2)。每盒都有2颗散糖，所以也等于3x＋6。",
      "counterexample": "3×(x＋2)不能写成3x＋2，那样只记了一盒的散糖，漏了另外两盒。",
      "lessonIds": [
        "algebra.substitution.intro",
        "algebra.balance.intro"
      ]
    }
  },
